# yolka — secrets template.
# Copy to <profile>/.env and fill in your real keys. NEVER commit this file
# with real values — GitHub secret scanning + partner alerting will burn them.
#
#   cp .env.example ~/.hermes/profiles/yolka/.env
#   chmod 600 ~/.hermes/profiles/yolka/.env

# Primary LLM provider (matches config.yaml model.provider: opencode-go)
OPENCODE_GO_API_KEY=your-opencode-go-api-key

# Gateway API server key (only needed if you expose gateway.platforms.api_server)
# Generate with: openssl rand -hex 32
# API_SERVER_KEY=

# Optional: fallback provider keys
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
